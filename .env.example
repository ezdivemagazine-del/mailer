# ── 必填 ──────────────────────────────────────────────────
# OpenAI API 金鑰（從 platform.openai.com 取得）
OPENAI_API_KEY=sk-proj-在這裡填入你的Key

# 加密金鑰：用來加密儲存的 SMTP 密碼，請自行改成任意一段不規則字串（英數皆可，越長越好）
SECRET_KEY=請把這行換成你自己的隨機字串例如abc123xyz789

# ── 選填 ──────────────────────────────────────────────────
# AI 模型（預設 gpt-4o，如需省成本可改 gpt-4o-mini）
OPENAI_MODEL=gpt-4o

# 資料庫路徑（Docker 環境下通常不需要改）
DB_PATH=/app/data/mailer.db
